<Window x:Class="Dbf2XlsxConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Dbf2XlsxConverter"
        xmlns:vm="clr-namespace:Dbf2XlsxConverter.ViewModels"
        Title="DBF → XLSX Мультиконвертер" Height="540" Width="800"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Добавить файлы" Margin="0,0,8,0" Click="AddFiles_Click"/>
            <Button Content="Выбрать папку для экспорта" Margin="0,0,8,0" Click="SelectOutput_Click"/>
            <TextBlock Text="Папка вывода:" VerticalAlignment="Center"/>
            <TextBox Width="200" Margin="4,0" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
            <TextBlock Text="Потоки:" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <TextBox Width="32" Text="{Binding MaxDegreeOfParallelism, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Старт" Command="{Binding StartConversionCommand}" Margin="8,0,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="#aaa" BorderThickness="1" CornerRadius="8" AllowDrop="True" Background="#f3f6fa"
                DragOver="Files_DragOver" Drop="Files_Drop" Padding="8">
            <DockPanel>
                <TextBlock Text="Перетащите сюда .dbf-файлы…" VerticalAlignment="Center" Foreground="#888" FontSize="14"/>
            </DockPanel>
        </Border>
        <DataGrid Grid.Row="2" Margin="0,8" ItemsSource="{Binding FilesQueue}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Файл" Binding="{Binding SourcePath}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="80"/>
                <DataGridTextColumn Header="Сообщение" Binding="{Binding ErrorMessage}" Width="150"/>
                <DataGridTextColumn Header="Длительность" Binding="{Binding Duration}" Width="60"/>
                <DataGridTemplateColumn Header="Прогресс" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ProgressBar Minimum="0" Maximum="100" Height="18" Value="{Binding Progress}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBox Grid.Row="3" IsReadOnly="True" Height="64" Margin="0,4,0,0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontSize="12" BorderBrush="#b8b8b8" BorderThickness="1" Foreground="#444"
                 Text="{Binding FilesQueue[0].ErrorMessage, FallbackValue='Здесь будет отображаться лог ошибок...'}"/>
    </Grid>
</Window>
